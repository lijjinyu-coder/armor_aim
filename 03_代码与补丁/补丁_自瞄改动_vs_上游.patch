+"""aim_output — 自瞄输出抽象层（AimResult -> 调试输出 / ROS2 云台输出）。"""
diff --git a/src/prm_control/aim_output/aim_output/aim_output_node.py b/src/prm_control/aim_output/aim_output/aim_output_node.py
new file mode 100644
index 0000000..63632a8
